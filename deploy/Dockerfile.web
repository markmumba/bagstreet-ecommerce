# Storefront + admin (static builds) served by Caddy, which also proxies the API and images.
# Build from the repo root:
#   docker build -f deploy/Dockerfile.web --build-arg VITE_SERVER_URL=https://api.example.co.ke -t bagstreet-web .
FROM oven/bun:1.3.3-slim AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY client/package.json client/
COPY storefront/package.json storefront/
RUN bun install --frozen-lockfile --ignore-scripts

FROM deps AS build
# Baked into the JS bundles at build time — rebuild the image if the API domain changes.
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=${VITE_SERVER_URL}
COPY tsconfig.json turbo.json ./
COPY shared shared
COPY server server
COPY client client
COPY storefront storefront
RUN test -n "$VITE_SERVER_URL" || (echo "VITE_SERVER_URL build arg is required" && exit 1)
RUN cd shared && bun run build \
 && cd ../server && bunx tsc --emitDeclarationOnly --outDir dist \
 && cd ../client && bun run build \
 && cd ../storefront && bun run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/storefront/dist /srv/storefront
COPY --from=build /app/client/dist /srv/admin
