# Caddy: automatic HTTPS (Let's Encrypt), the storefront and admin static sites, and the API proxy.
# Domains come from the environment (see deploy/.env.production.example).
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# Content-Security-Policy: the browser runs only scripts served from the site itself, and the page
# can only talk to the API and load images from the media CDN. If a script ever gets injected, it
# can't load more code or send data elsewhere. The built apps have no inline scripts; inline
# styles stay allowed because UI libraries set them. STORAGE_PUBLIC_URL must be an origin (no path).
(csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' {args[0]}; font-src 'self' {args[1]}; img-src 'self' data: blob: {$STORAGE_PUBLIC_URL}; connect-src 'self' https://{$API_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

(spa) {
	encode zstd gzip
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# Storefront
{$SHOP_DOMAIN} {
	import security_headers
	import csp "" ""
	root * /srv/storefront
	import spa
}

www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

# Admin dashboard (has its own login; kept out of search engines)
{$ADMIN_DOMAIN} {
	import security_headers
	# The admin loads its Inter font from Google Fonts.
	import csp https://fonts.googleapis.com https://fonts.gstatic.com
	header X-Robots-Tag "noindex, nofollow"
	root * /srv/admin
	import spa
}

# API. Caddy overwrites X-Forwarded-For with the real client IP, so the API runs with TRUST_PROXY_HOPS=1.
{$API_DOMAIN} {
	import security_headers
	request_body {
		max_size 16MB
	}
	reverse_proxy api:3000
}

# Product images are served by DigitalOcean Spaces' CDN, not this server (see docs/deployment.md).
