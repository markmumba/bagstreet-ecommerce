# Caddy: automatic HTTPS (Let's Encrypt), the storefront and admin static sites, and the API proxy.
# Domains come from the environment (see deploy/.env.production.example).
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

(spa) {
	encode zstd gzip
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# Storefront
{$SHOP_DOMAIN} {
	import security_headers
	root * /srv/storefront
	import spa
}

www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

# Admin dashboard (has its own login; kept out of search engines)
{$ADMIN_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	root * /srv/admin
	import spa
}

# API. Caddy overwrites X-Forwarded-For with the real client IP, so the API runs with TRUST_PROXY_HOPS=1.
{$API_DOMAIN} {
	import security_headers
	request_body {
		max_size 16MB
	}
	reverse_proxy api:3000
}

# Product images are served by DigitalOcean Spaces' CDN, not this server (see docs/deployment.md).
