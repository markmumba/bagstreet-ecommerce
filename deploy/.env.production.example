# Copy to .env.production in the repo root on the server, fill in, then: chmod 600 .env.production
# Never commit the real file (it's in .gitignore). Generate secrets with: openssl rand -hex 32

# --- Domains (DNS A records → droplet IP) -----------------------------------
SHOP_DOMAIN=example.co.ke
ADMIN_DOMAIN=admin.example.co.ke
API_DOMAIN=api.example.co.ke
# Let's Encrypt account / expiry notices
ACME_EMAIL=you@example.co.ke

# --- Images built by GitHub Actions (see docs/deployment.md) -----------------
IMAGE_REGISTRY=ghcr.io/markmumba
# A release tag like v1.0.0 (recommended), or "latest"
IMAGE_TAG=latest

# --- Data directory on the attached block storage volume --------------------
DATA_DIR=/mnt/bagstreet

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=bagstreet
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=bagstreet

# --- Auth (each at least 32 characters, different from each other) ---------
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-32

# --- Images: DigitalOcean Spaces --------------------------------------------
# Create the Space first (File Listing: Restricted, CDN: enabled). Use a limited-access key
# scoped to this Space with Read/Write/Delete.
STORAGE_ENDPOINT=fra1.digitaloceanspaces.com
STORAGE_PORT=443
STORAGE_USE_SSL=true
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bagstreet-media
STORAGE_ACCESS_KEY=DO00EXAMPLEKEY
STORAGE_SECRET_KEY=change-me
STORAGE_OBJECT_ACL=public-read
# CDN endpoint of the Space (or your custom CDN subdomain), objects directly under it
STORAGE_PUBLIC_URL=https://bagstreet-media.fra1.cdn.digitaloceanspaces.com

# --- Rate limiting (internal Redis) -------------------------------------------
REDIS_REST_TOKEN=change-me-openssl-rand-hex-32

# --- Email (pick one) ---------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM=Bagstreet <orders@example.co.ke>
RESEND_API_KEY=
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Pesapal ------------------------------------------------------------------
PESAPAL_ENV=production
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Register https://<API_DOMAIN>/api/payments/pesapal/ipn as the IPN URL in Pesapal, then paste its id
PESAPAL_IPN_ID=

# --- Behaviour ----------------------------------------------------------------
UNPAID_ORDER_TTL_MINUTES=45
# Explicit opt-in only. First reminder after 2h; optional final reminder after 24h.
CART_RECOVERY_ENABLED=true
CART_RECOVERY_FOLLOWUP_ENABLED=false
# Proxies in front of the API: 1 = Caddy only. 2 if Cloudflare's proxy sits in front of Caddy.
TRUST_PROXY_HOPS=1
