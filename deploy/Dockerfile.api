# API server (Bun + Hono). Build from the repo root:
#   docker build -f deploy/Dockerfile.api -t bagstreet-api .
FROM oven/bun:1.3.3-slim AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY client/package.json client/
COPY storefront/package.json storefront/
# --ignore-scripts: the root postinstall runs a turbo build before sources are copied.
RUN bun install --frozen-lockfile --ignore-scripts

FROM deps AS build
COPY tsconfig.json ./
COPY shared shared
RUN cd shared && bun run build

# Runtime needs only the server's (and shared's) production dependencies — not the admin/storefront
# front-end packages or build tools. Keeps the image small for the registry and quick to pull.
FROM oven/bun:1.3.3-slim AS prod-deps
WORKDIR /app
COPY package.json bun.lock ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY client/package.json client/
COPY storefront/package.json storefront/
RUN bun install --frozen-lockfile --ignore-scripts --production --filter server --filter shared

FROM oven/bun:1.3.3-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=prod-deps /app/node_modules node_modules
COPY --from=build /app/shared shared
COPY package.json tsconfig.json ./
COPY server server
# Workspace packages resolve through node_modules symlinks to these folders.
USER bun
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:3000/health/live').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["bun", "run", "server/src/preview.ts"]
